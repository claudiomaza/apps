function ensureOperationalSheet_(name,headers){
 const book=book_();let sh=book.getSheetByName(name);if(!sh){const blank=book.getSheets().find(x=>x.getLastRow()===0&&x.getLastColumn()===0);if(blank){blank.setName(name);sh=blank;}else sh=book.insertSheet(name);}
 if(!sh.getLastRow())sh.getRange(1,1,1,headers.length).setValues([headers]);
 else{const existing=sh.getRange(1,1,1,Math.max(headers.length,sh.getLastColumn())).getDisplayValues()[0];if(name==='Config'&&existing[0]==='key'&&existing[1]==='value'&&!existing[2])sh.getRange(1,3).setValue('description');else if(name==='Usuarios'&&existing.slice(0,6).join('|')==='usuario|pass|rol|alcances|mail|nombre'&&!existing[6])sh.getRange(1,7).setValue('docenteId');else if(headers.some((h,i)=>existing[i]!==h))throw Error('DATABASE_SCHEMA_MISMATCH:'+name);}
 sh.setFrozenRows(1);sh.getRange(1,1,1,headers.length).setFontWeight('bold').setWrap(true);if(sh.getFilter()===null)sh.getRange(1,1,Math.max(1,sh.getLastRow()),headers.length).createFilter();return sh;
}
function setupDatabase_(){const lock=LockService.getScriptLock();if(!lock.tryLock(5000))throw Error('BUSY_RETRY');try{for(const [name,headers] of DB_SCHEMA_)ensureOperationalSheet_(name,headers);const config=book_().getSheetByName('Config'),values=config.getDataRange().getDisplayValues(),keys=new Set(values.slice(1).map(r=>r[0]));for(const [key,value,description] of [['maxPageSize','300','Máximo de registros por página.'],['maxBatchSize','100','Máximo de cambios por sincronización.']])if(!keys.has(key))config.getRange(config.getLastRow()+1,1,1,3).setValues([[key,value,description]]);refreshReadableViews_();SpreadsheetApp.flush();SpreadsheetApp.getUi().alert('Estructura y tablas legibles actualizadas. No se borró ningún dato.');}finally{lock.releaseLock();}}
function resetDatabase_(){const html=HtmlService.createHtmlOutput(`<div style="font:14px Arial,sans-serif;padding:18px"><h2>Resetear la base de datos de MGD</h2><p><b>Acción irreversible:</b> se eliminarán todas las hojas y filas actuales de este libro; se crearán las cuatro hojas operativas y las vistas tabulares derivadas vacías. Primero descargá una copia de seguridad si necesitás conservar algo.</p><label>Correo del administrador (se guardará como correo de perfil; el usuario de acceso será admin)<br><input id="mail" type="email" autocomplete="email" required></label><br><label>Escribí exactamente RESETEAR para confirmar<br><input id="confirm" autocomplete="off" required></label><p><button id="go" style="padding:10px 16px">Borrar hojas y crear la base</button></p><p id="status" role="status" aria-live="polite"></p><script>document.getElementById("go").onclick=()=>{const b=document.getElementById("go"),s=document.getElementById("status"),mail=document.getElementById("mail").value.trim(),confirmation=document.getElementById("confirm").value;if(!mail){s.textContent="Ingresá el correo del administrador.";return;}if(confirmation!=="RESETEAR"){s.textContent="Escribí exactamente RESETEAR para confirmar.";return;}if(!confirm("Se borrarán todas las hojas y datos de este libro. ¿Continuar solo si ya tenés una copia de seguridad?"))return;b.disabled=true;s.textContent="Reseteando…";google.script.run.withSuccessHandler(r=>{s.textContent="Base vacía creada. Usuario admin: "+r.username+". Contraseña temporal (guardala ahora, no se volverá a mostrar): "+r.temporaryPassword;b.disabled=false;}).withFailureHandler(e=>{s.textContent="No se completó: "+e.message;b.disabled=false;}).resetDatabase({mail,confirmation});};</script></div>`).setWidth(520).setHeight(430);SpreadsheetApp.getUi().showModalDialog(html,'Resetear MGD');}
function resetDatabase(request){const b=request||{};if(b.confirmation!=='RESETEAR')throw Error('RESET_CONFIRMATION_REQUIRED');const mail=String(b.mail||'').trim();if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(mail)||mail.length>254)throw Error('INVALID_ADMIN_EMAIL');const username='admin',password=Utilities.getUuid().replace(/-/g,'')+'Aa1!',name='Administrador';const lock=LockService.getScriptLock();if(!lock.tryLock(5000))throw Error('BUSY_RETRY');try{const book=book_(),sheets=book.getSheets(),keep=sheets[0];for(const sh of sheets.slice(1))book.deleteSheet(sh);if(keep.getFilter())keep.getFilter().remove();keep.clear();if(keep.getName()!=='Registros')keep.setName('Registros');for(const [sheetName,headers] of DB_SCHEMA_){const sh=sheetName==='Registros'?keep:book.insertSheet(sheetName);sh.getRange(1,1,1,headers.length).setValues([headers]);sh.setFrozenRows(1);sh.getRange(1,1,1,headers.length).setFontWeight('bold').setWrap(true);sh.getRange(1,1,1,headers.length).createFilter();}book.getSheetByName('Config').getRange(2,1,2,3).setValues([['maxPageSize','300','Máximo de registros por página.'],['maxBatchSize','100','Máximo de cambios por sincronización.']]);book.getSheetByName('Usuarios').getRange(2,1,1,7).setValues([[username,password,'admin','[]',mail,name,'']]);refreshReadableViews_();SpreadsheetApp.flush();PropertiesService.getScriptProperties().deleteProperty('DATA_VERSION');return{ok:true,username,temporaryPassword:password};}finally{lock.releaseLock();}}

function refreshReadableViews_(){
 const book=book_(),data=dataSheet_(),last=data.getLastRow(),rows=last>1?data.getRange(2,1,last-1,CONFIG.HEADERS.length).getValues():[];
 const byType=new Map(READABLE_VIEWS_.map(([name,type])=>[type,[]]));
 for(const row of rows){if(!row[0])continue;const target=byType.get(String(row[1]));if(!target)continue;let value;try{value=JSON.parse(String(row[3]||'{}'));}catch(_){throw Error('INVALID_STORED_RECORD');}target.push([row[0],row[2],value,row[4],row[5],row[6],row[7]]);}
 const outputs=READABLE_VIEWS_.map(([name,type,fields])=>{const source=byType.get(type)||[],baseHeader=['recordId','entityId',...fields.map(x=>x[1])],known=new Set(fields.map(x=>x[0])),extra=[...new Set(source.flatMap(x=>Object.keys(x[2])))].filter(k=>!known.has(k)).sort(),sheet=book.getSheetByName(name),oldHeader=sheet&&sheet.getLastRow()?sheet.getRange(1,1,1,sheet.getLastColumn()).getDisplayValues()[0]:[],meta=['version','status','updatedAt','createdAt'];if(oldHeader.length&&baseHeader.some((h,i)=>oldHeader[i]!==h))throw Error('READABLE_VIEW_SCHEMA_MISMATCH:'+name);const oldExtras=oldHeader.slice(baseHeader.length,Math.max(baseHeader.length,oldHeader.length-meta.length)).filter(Boolean),allExtra=[...new Set([...oldExtras,...extra])],header=[...baseHeader,...allExtra,...meta];if(header.length>26)throw Error('READABLE_VIEW_TOO_WIDE:'+name);const allFields=[...fields,...allExtra.map(key=>[key,key])],values=source.map(([recordId,id,d,version,status,updatedAt,createdAt])=>[recordId,id,...allFields.map(([key])=>readableCell_(d[key])),version,status,updatedAt,createdAt]);return{name,header,values};});
 const teacherOutput={name:'Docentes',header:['teacherId','username','nombre','correo','alcances'],values:readableTeachers_()};
 for(const output of [...outputs,teacherOutput])assertReadableViewSheet_(book,output.name,output.header);
 for(const output of outputs)writeReadableView_(book,output.name,output.header,output.values);
 writeReadableView_(book,teacherOutput.name,teacherOutput.header,teacherOutput.values);
}
function assertReadableViewSheet_(book,name,headers){const s=book.getSheetByName(name);if(!s)return;const last=Math.max(s.getLastColumn(),headers.length),current=s.getLastRow()?s.getRange(1,1,1,last).getDisplayValues()[0]:[];if(current.some((v,i)=>v&&v!==headers[i]))throw Error('READABLE_VIEW_SCHEMA_MISMATCH:'+name);}
function readableTeachers_(){const s=book_().getSheetByName(CONFIG.USERS_SHEET);if(!s)throw Error('USERS_SHEET_NOT_FOUND');const last=s.getLastRow();if(!last)return[];const ids=s.getRange(1,1,last,1).getDisplayValues(),details=s.getRange(1,3,last,5).getDisplayValues(),header=[ids[0][0],...details[0]];if(!['usuario|rol|alcances|mail|nombre|docenteId'].includes(header.join('|')))throw Error('USERS_SHEET_INVALID');return ids.slice(1).map((r,i)=>{const d=details[i+1]||[],role=String(d[0]||'').trim().toLowerCase();return role==='docente'&&String(r[0]||'').trim()?[String(d[4]||'').trim(),String(r[0]).trim(),String(d[3]||'').trim(),String(d[2]||'').trim(),String(d[1]||'[]').trim()]:null;}).filter(Boolean);}
function readableCell_(value){if(value===undefined||value===null)return'';if(Array.isArray(value)||typeof value==='object')value=JSON.stringify(value);if(typeof value==='string'&&/^[=+@]/.test(value))return"'"+value;return value;}
function writeReadableView_(book,name,headers,rows){let s=book.getSheetByName(name);if(!s)s=book.insertSheet(name);if(s.getFilter())s.getFilter().remove();s.clearContents();s.getRange(1,1,1,headers.length).setValues([headers]);s.setFrozenRows(1);s.getRange(1,1,1,headers.length).setFontWeight('bold').setWrap(true);for(let i=0;i<rows.length;i+=500)s.getRange(i+2,1,Math.min(500,rows.length-i),headers.length).setValues(rows.slice(i,i+500));s.getRange(1,1,Math.max(1,rows.length+1),headers.length).createFilter();}
function refreshReadableViewsSafe_(){try{refreshReadableViews_();}catch(e){if(typeof Logger!=='undefined')Logger.log('Readable views refresh failed: '+String(e&&e.message||e));}}
function doGet(){return json_({ok:true,service:'gradebook-normalized',schemaVersion:1});}
function doPost(e){try{const b=JSON.parse(e&&e.postData&&e.postData.contents||'{}');if(b.action==='auth'){const result=authenticate_(String(b.user||''),String(b.pass||''));if(b.includeInitialList===true){try{result.records=listRecords_({limit:b.limit},result.access);}catch(err){result.initialListError=publicError_(err);}}return json_(result);}const access=requireSession_(b.sessionToken);switch(b.action){case'changePassword':return json_(changePassword_(b,access));case'listRecords':return json_(listRecords_(b,access));case'listUsers':return json_(listUsers_(access));case'saveTeacher':return json_(saveTeacher_(b,access));case'saveTeacherScopes':return json_(saveTeacherScopes_(b,access));case'saveAvailability':return json_(saveAvailability_(b,access));case'listAvailability':return json_(listAvailability_(b,access));case'deleteAvailability':return json_(deleteAvailability_(b,access));case'listTrash':return json_(listTrash_(b,access));case'saveBatch':return json_(saveBatch_(b,access));case'trashRecord':return json_(changeRecordStatus_(b,true,access));case'restoreRecord':return json_(changeRecordStatus_(b,false,access));default:throw Error('INVALID_ACTION');}}catch(err){return json_({ok:false,error:publicError_(err)});}}
function book_(){return SpreadsheetApp.openById('1d9yL3ZhjdQIxRQEFVXltRA_QtjIZc6UrcO_1NyT1oA4');}
function config_(){const s=book_().getSheetByName('Config');if(!s)throw Error('CONFIG_SHEET_NOT_FOUND');const v=s.getDataRange().getDisplayValues();if(!v.length||v[0][0]!=='key'||v[0][1]!=='value')throw Error('CONFIG_SHEET_INVALID');const o={};v.slice(1).forEach(r=>{if(r[0]){if(Object.prototype.hasOwnProperty.call(o,r[0]))throw Error('CONFIG_SHEET_INVALID');o[r[0]]=r[1];}});return o;}
function setting_(key,def,min,max){const raw=config_()[key];if(raw==null||raw==='')return def;if(!/^\d+$/.test(String(raw)))throw Error('CONFIG_VALUE_INVALID');const n=Number(raw);if(n<min||n>max)throw Error('CONFIG_VALUE_INVALID');return n;}
function parseAccess_(role,scopesText){role=String(role||'').trim().toLowerCase();if(!['admin','docente'].includes(role))throw Error('USERS_SHEET_INVALID');let scopes;try{scopes=JSON.parse(scopesText||'[]');}catch(_){throw Error('USERS_SHEET_INVALID');}if(!Array.isArray(scopes)||scopes.length>CONFIG.MAX_SCOPES||(role==='admin'&&scopes.length))throw Error('USERS_SHEET_INVALID');const seen=new Set(),clean=scopes.map(s=>{if(!s||typeof s!=='object'||Array.isArray(s)||Object.keys(s).sort().join(',')!=='courseId,divisionId,schoolId,subjectId'||Object.values(s).some(v=>typeof v!=='string'||!v.trim()||v.length>120))throw Error('USERS_SHEET_INVALID');const x={schoolId:s.schoolId.trim(),subjectId:s.subjectId.trim(),courseId:s.courseId.trim(),divisionId:s.divisionId.trim()},key=scopeKey_(x);if(seen.has(key))throw Error('USERS_SHEET_INVALID');seen.add(key);return x;});return{role,scopes:clean};}
function scopeKey_(s){return JSON.stringify([s.schoolId,s.subjectId,s.courseId,s.divisionId]);}
function validateTeacherInput_(b,users,rows){const username=String(b.username||'').trim(),password=String(b.password||''),mail=String(b.mail||'').trim(),name=String(b.name||'').trim(),teacherId=String(b.teacherId||'').trim(),scopes=Array.isArray(b.scopes)?b.scopes:[];if(!/^[\p{L}\p{N}._@+-]{1,80}$/u.test(username)||username.length>80||!mail||mail.length>254||!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(mail)||!name||name.length>200||!teacherId||teacherId.length>80||/[\u0000-\u001f\u007f]/.test(mail+name+teacherId))throw Error('INVALID_USER');if(scopes.length>CONFIG.MAX_SCOPES)throw Error('INVALID_USER_SCOPES');const clean=scopes.length?parseAccess_('docente',JSON.stringify(scopes)).scopes:[];for(const s of clean){for(const [type,id] of [['school',s.schoolId],['subject',s.subjectId],['course',s.courseId],['division',s.divisionId]])if(!rows.some(r=>r[1]===type&&r[2]===id&&r[5]==='ACTIVE'))throw Error('USER_SCOPE_NOT_FOUND');if(!rows.some(r=>r[5]==='ACTIVE'&&['membership','assessment','schedule','attendance','observation','topic'].includes(r[1])&&scopeMatches_(rowData_(r),[s])))throw Error('USER_SCOPE_NOT_FOUND');}const editing=String(b.existingUsername||'').trim(),existing=editing?users.find(u=>u.username.toLowerCase()===editing.toLowerCase()):null;if(editing&&(!existing||existing.access.role!=='docente'))throw Error('USER_NOT_FOUND');if(editing&&username.toLowerCase()!==existing.username.toLowerCase())throw Error('USERNAME_TAKEN');if(!editing&&users.some(u=>u.username.toLowerCase()===username.toLowerCase()))throw Error('USERNAME_TAKEN');if(users.some(u=>u.access.role==='docente'&&String(u.profile.teacherId||'').toLowerCase()===teacherId.toLowerCase()&&u.username.toLowerCase()!==(existing?.username||'').toLowerCase()))throw Error('TEACHER_ID_TAKEN');if(password&&password.length<12)throw Error('WEAK_PASSWORD');if(password.length>200)throw Error('INVALID_USER');if(!editing&&!password)throw Error('WEAK_PASSWORD');if(editing&&!password&&!existing.password)throw Error('WEAK_PASSWORD');return{username,password,mail,name,teacherId,scopes:clean,existing};}
function requireAdmin_(access){if(!access||access.role!=='admin')throw Error('ACCESS_DENIED');return true;}

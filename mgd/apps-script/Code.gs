function saveTeacherScopes_(b,access){requireAdmin_(access);const username=String(b.username||'').trim(),user=users_().find(u=>u.username.toLowerCase()===username.toLowerCase());if(!user||user.access.role!=='docente')throw Error('USER_NOT_FOUND');const scopes=b.scopes;if(!Array.isArray(scopes)||scopes.length>CONFIG.MAX_SCOPES)throw Error('INVALID_USER_SCOPES');const clean=JSON.parse(JSON.stringify(scopes));if(clean.length>CONFIG.MAX_SCOPES||clean.some(s=>!s||!s.schoolId||!s.subjectId||!s.courseId||!s.divisionId))throw Error('INVALID_USER_SCOPES');const sh=book_().getSheetByName(CONFIG.USERS_SHEET),rows=sh.getDataRange().getDisplayValues(),data=dataSheet_(),last=data.getLastRow(),records=last>1?data.getRange(2,1,last-1,CONFIG.HEADERS.length).getValues():[];for(const s of clean){for(const [type,id] of [['school',s.schoolId],['subject',s.subjectId],['course',s.courseId],['division',s.divisionId]])if(!records.some(r=>r[1]===type&&r[2]===id&&r[5]==='ACTIVE'))throw Error('USER_SCOPE_NOT_FOUND');if(!records.some(r=>r[5]==='ACTIVE'&&['membership','assessment','schedule','attendance','observation','topic'].includes(r[1])&&scopeMatches_(rowData_(r),[s])))throw Error('USER_SCOPE_NOT_FOUND');}const rowIndex=rows.findIndex(r=>String(r[0]).trim().toLowerCase()===user.username.toLowerCase());if(rowIndex<1)throw Error('USER_NOT_FOUND');sh.getRange(rowIndex+1,4).setValue(JSON.stringify(clean));SpreadsheetApp.flush();refreshReadableViewsSafe_();return{ok:true,user:{username:user.username,teacherId:user.profile.teacherId||'',scopes:clean}};}

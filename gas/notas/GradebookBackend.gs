function validateRecord_(x){if(!x||typeof x!=='object'||!/^[-\w:]{1,200}$/.test(String(x.recordId||''))||!/^[-\w:]{1,120}$/.test(String(x.id||''))||x.recordId!==`${x.type}::${x.id}`||!['school','course','division','subject','subgroup','student','membership','cutoff','scale','assessment','grade'].includes(x.type)||!x.data||typeof x.data!=='object'||Array.isArray(x.data))throw Error('INVALID_RECORD');const d=x.data;if(x.type==='student'&&(!String(d.studentId||'').trim()||String(d.studentId).length>80||/[\u0000-\u001f\u007f]/.test(String(d.studentId))||!String(d.fullName||'').trim()||String(d.fullName).length>120))throw Error('INVALID_RECORD');if(x.type==='grade'&&(!d.studentId||!d.assessmentId||!['graded','absent','not_submitted','pending','exempt'].includes(d.status)||d.value===undefined||String(d.observation||'').length>1000||!/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/.test(String(d.gradeDate||''))))throw Error('INVALID_RECORD');if(x.type==='membership'&&(!d.studentId||!d.schoolId||!d.subjectId||!d.courseId||!d.divisionId))throw Error('INVALID_RECORD');if(x.type==='scale'&&(!String(d.name||'').trim()||!Number.isInteger(Number(d.min))||!Number.isInteger(Number(d.max))||Number(d.max)<Number(d.min)||!['numeric','qualitative'].includes(d.mode)||JSON.stringify(d.intervals||[]).length>3000))throw Error('INVALID_RECORD');if(x.type==='assessment'&&(!d.name||!d.schoolId||!d.subjectId||!d.courseId||!d.divisionId||!d.cutoffId||!d.scaleId||!Number.isFinite(Number(d.weight))||Number(d.weight)<0||Number(d.weight)>100||typeof d.weightLocked!=='boolean'))throw Error('INVALID_RECORD');const json=JSON.stringify(d);if(json.length>12000)throw Error('INVALID_RECORD');return{recordId:x.recordId,type:x.type,id:x.id,dataJson:json};}
function saveBatch_(b){const items=b.records;if(!Array.isArray(items)||!items.length||items.length>setting_('maxBatchSize',CONFIG.MAX_BATCH_SIZE,1,CONFIG.MAX_BATCH_SIZE))throw Error('INVALID_BATCH');const seen=new Set(),valid=items.map(x=>{const v=validateRecord_(x);if(seen.has(v.recordId))throw Error('INVALID_BATCH');seen.add(v.recordId);return{input:x,value:v,expected:Number(x.expectedVersion)||0};}),lock=LockService.getScriptLock();if(!lock.tryLock(5000))throw Error('BUSY_RETRY');try{const sh=dataSheet_(),last=sh.getLastRow(),rows=last>1?sh.getRange(2,1,last-1,CONFIG.HEADERS.length).getValues():[],index=new Map(rows.map((r,i)=>[r[0],{r,row:i+2}])),studentIds=new Map();rows.forEach(r=>{if(r[1]==='student'){try{const d=JSON.parse(r[3]);if(d.studentId)studentIds.set(String(d.studentId),r[0]);}catch(_){}}});for(const x of valid){if(x.value.type==='student'){const studentId=String(JSON.parse(x.value.dataJson).studentId||'').trim(),existingId=studentIds.get(studentId);if(existingId&&existingId!==x.value.recordId)throw Error('DUPLICATE_STUDENT_ID');studentIds.set(studentId,x.value.recordId);}}for(const x of valid){if(x.value.type!=='assessment')continue;const a=JSON.parse(x.value.dataJson),peers=valid.filter(y=>y.value.type==='assessment'&&y.input.data.subjectId===a.subjectId&&y.input.data.cutoffId===a.cutoffId);const existingAssessments=rows.filter(r=>r[1]==='assessment'&&!peers.some(y=>y.value.recordId===r[0])).map(r=>{const d=JSON.parse(r[3]);return{weight:Number(d.weight||0),locked:!!d.weightLocked};});const fixed=existingAssessments.filter(x=>x.locked).reduce((sum,x)=>sum+x.weight,0)+peers.filter(y=>y.input.data.weightLocked).reduce((sum,y)=>sum+Number(y.input.data.weight||0),0),openExisting=existingAssessments.filter(x=>!x.locked).length,openPeers=peers.filter(y=>!y.input.data.weightLocked).length;if(fixed>100.00001||(!openExisting&&!openPeers&&Math.abs(fixed-100)>.00001))throw Error('WEIGHT_REMAINDER');}const now=new Date().toISOString(),results=[],writes=[],virtual=new Map(index);for(const x of valid){const old=virtual.get(x.value.recordId);if((!old&&x.expected!==0)||(old&&Number(old.r[4])!==x.expected)){const conflict={recordId:x.value.recordId,status:'conflict',version:old?Number(old.r[4]):0,current:old&&old.row>0?unpack_(old.r):null};results.push(conflict);continue;}const version=old?Number(old.r[4])+1:1,created=old?old.r[7]:now,row=[x.value.recordId,x.value.type,x.value.id,x.value.dataJson,version,'ACTIVE',now,created],write={rowNum:old&&old.row>0?old.row:0,row,recordId:x.value.recordId,version};writes.push(write);virtual.set(x.value.recordId,{r:row,row:old&&old.row>0?old.row:-(writes.length)});results.push({recordId:x.value.recordId,status:old?'updated':'created',version});}const fresh=writes.filter(x=>x.rowNum===0),updates=writes.filter(x=>x.rowNum>0);if(fresh.length)sh.getRange(sh.getLastRow()+1,1,fresh.length,CONFIG.HEADERS.length).setValues(fresh.map(x=>x.row));applyRows_(sh,updates);if(writes.length){SpreadsheetApp.flush();const p=PropertiesService.getScriptProperties();p.setProperty('DATA_VERSION',String(Number(p.getProperty('DATA_VERSION')||0)+1));}return{ok:true,results};}finally{lock.releaseLock();}}

function config_(){const s=book_().getSheetByName('Config');if(!s)throw Error('CONFIG_SHEET_NOT_FOUND');const v=s.getDataRange().getDisplayValues();if(!v.length||v[0][0]!=='key'||v[0][1]!=='value')throw Error('CONFIG_SHEET_INVALID');const o={};v.slice(1).forEach(r=>{if(r[0]){if(Object.prototype.hasOwnProperty.call(o,r[0]))throw Error('CONFIG_SHEET_INVALID');o[r[0]]=r[1];}});return o;}

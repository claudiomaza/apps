const CONFIG = Object.freeze({
  SPREADSHEET_ID: '1eH_SMJcaPoA6tEkKakETRKS1TsvGXxHSXHlFB5m02yE',
  DATA_SHEET: 'Notas', CACHE_SECONDS: 45, MAX_PAGE_SIZE: 300,
  HEADERS: ['gradeId','studentId','studentName','courseId','courseName','assessmentId','assessmentName','score','maxScore','gradeDate','observation','status','version','createdAt','updatedAt']
});
function doPost(e) { try { const b=JSON.parse(e&&e.postData&&e.postData.contents||'{}'); if(b.action==='list') return json_(listGrades_(b)); if(b.action==='createBatch') return json_(createGradesBatch_(b)); if(!['create','update','delete'].includes(b.action)) throw Error('INVALID_ACTION'); return json_(mutateGrade_(b.action,b)); } catch(err) { return json_({ok:false,error:publicError_(err)}); } }
function doGet() { return json_({ok:true,service:'apps-gradebook',schemaVersion:1}); }
function listGrades_(q) { const limit=Math.min(Math.max(Number(q.limit)||100,1),CONFIG.MAX_PAGE_SIZE), cache=CacheService.getScriptCache(), version=PropertiesService.getScriptProperties().getProperty('DATA_VERSION')||'0', key=`grades:v1:${version}:${limit}`; const hit=cache.get(key); if(hit)return JSON.parse(hit); const sh=dataSheet_(), vals=sh.getDataRange().getValues(), records=vals.slice(1).filter(r=>r[0]&&r[11]!=='DELETED').slice(-limit).reverse().map(rowObject_); const result={ok:true,records}; cache.put(key,JSON.stringify(result),CONFIG.CACHE_SECONDS); return result; }
function mutateGrade_(action,b) { const id=String(b.gradeId||''); if(!/^[\w-]{8,80}$/.test(id)) throw Error('INVALID_GRADE_ID'); const lock=LockService.getScriptLock(); if(!lock.tryLock(5000)) throw Error('BUSY_RETRY'); try { const sh=dataSheet_(), last=sh.getLastRow(), ids=last>1?sh.getRange(2,1,last-1,1).getDisplayValues().flat():[], i=ids.indexOf(id), now=new Date().toISOString(); let row; if(action==='create'){ if(i>=0)return {ok:true,record:rowObject_(sh.getRange(i+2,1,1,CONFIG.HEADERS.length).getValues()[0]),duplicate:true}; const d=validateGrade_(b.changes||{}); row=[id,d.studentId,d.studentName,d.courseId,d.courseName,d.assessmentId,d.assessmentName,d.score,d.maxScore,d.gradeDate,d.observation,'ACTIVE',1,now,now]; sh.getRange(last+1,1,1,row.length).setValues([row]); } else { if(i<0)throw Error('NOT_FOUND'); const rn=i+2, current=sh.getRange(rn,1,1,CONFIG.HEADERS.length).getValues()[0]; if(Number(b.expectedVersion)!==Number(current[12]))throw Error('CONFLICT'); if(current[11]==='DELETED')throw Error('NOT_FOUND'); if(action==='delete'){current[11]='DELETED';current[12]=Number(current[12])+1;current[14]=now;} else {const d=validateGrade_(Object.assign(rowObject_(current),b.changes||{})); [current[1],current[2],current[3],current[4],current[5],current[6],current[7],current[8],current[9],current[10]]=[d.studentId,d.studentName,d.courseId,d.courseName,d.assessmentId,d.assessmentName,d.score,d.maxScore,d.gradeDate,d.observation];current[12]=Number(current[12])+1;current[14]=now;} row=current;sh.getRange(rn,1,1,row.length).setValues([row]); }
 SpreadsheetApp.flush(); PropertiesService.getScriptProperties().setProperty('DATA_VERSION',String(Number(PropertiesService.getScriptProperties().getProperty('DATA_VERSION')||0)+1)); return {ok:true,record:rowObject_(row)}; } finally { lock.releaseLock(); } }
function createGradesBatch_(b){const items=b.records;if(!Array.isArray(items)||items.length<1||items.length>100)throw Error('INVALID_BATCH');const seen=new Set(),prepared=items.map(x=>{const id=String(x.gradeId||'');if(!/^[\\w-]{8,80}$/.test(id)||seen.has(id))throw Error('INVALID_BATCH');seen.add(id);return {id,d:validateGrade_(x.changes||{})};});const lock=LockService.getScriptLock();if(!lock.tryLock(5000))throw Error('BUSY_RETRY');try{const sh=dataSheet_(),last=sh.getLastRow(),existing=new Set(last>1?sh.getRange(2,1,last-1,1).getDisplayValues().flat():[]),fresh=prepared.filter(x=>!existing.has(x.id));if(fresh.length){const now=new Date().toISOString(),rows=fresh.map(({id,d})=>[id,d.studentId,d.studentName,d.courseId,d.courseName,d.assessmentId,d.assessmentName,d.score,d.maxScore,d.gradeDate,d.observation,'ACTIVE',1,now,now]);sh.getRange(last+1,1,rows.length,CONFIG.HEADERS.length).setValues(rows);SpreadsheetApp.flush();const p=PropertiesService.getScriptProperties();p.setProperty('DATA_VERSION',String(Number(p.getProperty('DATA_VERSION')||0)+1));}return {ok:true,accepted:fresh.map(x=>x.id),duplicates:prepared.filter(x=>existing.has(x.id)).map(x=>x.id)};}finally{lock.releaseLock();}}
function validateGrade_(d) { const score=Number(d.score), max=Number(d.maxScore), studentName=String(d.studentName||'').trim(), assessmentName=String(d.assessmentName||'').trim(), gradeDate=String(d.gradeDate||''); if(!studentName||studentName.length>120||!assessmentName||assessmentName.length>160||!Number.isFinite(score)||!Number.isFinite(max)||score<0||max<=0||score>max||!/^\d{4}-\d{2}-\d{2}$/.test(gradeDate))throw Error('INVALID_GRADE');return {studentId:String(d.studentId||'').slice(0,80),studentName,courseId:String(d.courseId||'').slice(0,80),courseName:String(d.courseName||'').trim().slice(0,100),assessmentId:String(d.assessmentId||'').slice(0,80),assessmentName,score,maxScore:max,gradeDate,observation:String(d.observation||'').slice(0,1000)}; }
function dataSheet_(){const s=SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID).getSheetByName(CONFIG.DATA_SHEET);if(!s)throw Error('SHEET_NOT_FOUND');return s;}
function rowObject_(r){const o={};CONFIG.HEADERS.forEach((h,i)=>o[h]=r[i] instanceof Date?r[i].toISOString():r[i]);return o;}
function json_(v){return ContentService.createTextOutput(JSON.stringify(v)).setMimeType(ContentService.MimeType.JSON);}
function publicError_(e){const ok=['INVALID_ACTION','INVALID_GRADE_ID','INVALID_GRADE','BUSY_RETRY','NOT_FOUND','CONFLICT','SHEET_NOT_FOUND'];return ok.includes(e.message)?e.message:'INTERNAL_ERROR';}
